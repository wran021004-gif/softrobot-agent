  "task": "passive_progressive_stiffness",
  "structure": "serial_passive_soft_arm",
  "retrieval_summary": "用张力/长度/活跃集核查机制；静力后做连续动力学、有效消融、时空离散检查，明确未决边界。",
  "status": {
    "diagnostic_method_supported": true,
    "cross_task_generalization": "unverified",
    "acceptance_certificate": false
  },
  "applicability": [
    "适用于含被动约束、分阶段外载或结构机制归因的软体机器人研究。",
    "推荐动作是待新任务检验的方法经验，不是可复用的获胜设计。"
  ],
  "confidence": {
    "observations": "reference_backed",
    "physical_interpretation": "within valid paired models",
    "generalization": "hypothesis requiring task-local validation"
  },
  "evidence_assessment": {
    "observed": [
      "静力有希望的候选可在动力学失败。",
      "有效消融与单工况通过是不同门槛。",
      "同设计两种较粗网格通过，更细网格的有约束响应未稳定。"
    ],
    "interpretation": [
      "有效配对模型支持目标被动约束贡献。"
    ],
    "unverified": [
      "对任意软臂、材料、载荷及空间精度均有效。",
      "本次更细网格失稳的唯一数值根因。"
    ]
  },
  "experiences": [
    {
      "principle": "【观察与模型内解释】把刚度变化与真实被动腱的松弛—承力切换一起验证。",
      "trigger": "声称小载柔顺、大载变硬，但机制尚未复核。",
      "recommended_action": "同查带符号位移、实际腱长相对固定放绳长度的残差、单侧约束状态和张力；逐方向检查。",
      "limitation": "单凭曲线形状不足以识别机制；不稳定窗口、摩擦、接触或材料非线性会影响解释。",
      "evidence": "accepted#/cases/*/evaluation/tendon_transitions; spatial#/meshes"
    },
    {
      "principle": "【可迁移设计假设】放绳余量、腱路及终止位置可作为约束激活区间的设计变量。",
      "trigger": "低载已经张紧或高载仍未有效限制位移。",
      "recommended_action": "仅在获授权设计域内做有界比较；每次变化重算无载平衡和完整响应，并检查真实孔位及绳路。",
      "limitation": "几何、载荷、密度与边界条件会改变作用；本案例不提供跨任务通用参数或调节公式。",
      "evidence": "c01#/curves/1; c05#/curves/1; c16_static#/curves"
    },
    {
      "principle": "【观察】静力/KKT 筛选成功不能替代软约束动力学验收。",
      "trigger": "局部非线性静力预测已满足位移或刚度条件。",
      "recommended_action": "继续独立连续加载—卸载，检查末窗速度、漂移、静力残差和全过程约束；保留失败与未知成本。",
      "limitation": "局部求解失败不证明结构无解；硬绳静力模型和软约束动力学的结论不能互换。",
      "evidence": "c16_static; c16_dynamic; c17_invalid; c18_invalid"
    },
    {
      "principle": "【观察】单工况成功只覆盖该工况，联合成功必须覆盖冻结的完整组合。",
      "trigger": "某方向或载荷已通过，但卸载、另一方向或机制检验尚缺失。",
      "recommended_action": "保持同一结构和输入约束，独立检查所有规定方向、载荷阶段、恢复和额外门槛，再决定是否停止。",
      "limitation": "不能组合不同结构的单向通过，也不能把未决检验默认为通过；有限工况不证明全局鲁棒性。",
      "evidence": "c25_plus; c25_ablation; accepted#/cases"
    },
    {
      "principle": "【模型内因果证据】稳定、可比较的配对消融可区分目标约束与骨架自身响应。",
      "trigger": "需要区分被动腱作用与材料、几何硬化或碰撞止挡。",
      "recommended_action": "只禁用目标约束，保持实体、质量、惯量、环境及载荷一致；在两组都稳定有效时比较位移和增量刚度。",
      "limitation": "任一组无效时机制结论为未决；消融不自动排除未建模效应或跨精度数值耦合。",
      "evidence": "accepted#/mechanism; spatial#/meshes/2/paired_mechanism_plus_x; spatial#/meshes/4/paired_mechanism_plus_x"
    },
    {
      "principle": "【观察】时间积分、空间离散和物理可信度应分别报告。",
      "trigger": "粗离散通过或时间步减半后结果接近。",
      "recommended_action": "固定连续设计、质量、腱路和放绳长度，单独加密空间；重新建立合法平衡并检查每个网格的稳定性和机制门槛。",
      "limitation": "三组有限网格不构成严格数学收敛证明；固定时间步加密失败可能涉及约束/时间步耦合，未稳定均值不能证明静态收敛，仿真也不等于硬件证据。",
      "evidence": "accepted#/cases/half_plus_x; spatial#/verdict; spatial#/changes"
    }
  ],
