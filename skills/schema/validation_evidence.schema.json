  "properties": {
    "skill_ref": {
      "pattern": "^[A-Za-z0-9_.-]+@[1-9][0-9]*$",
      "title": "Skill Ref",
      "type": "string"
    },
    "strategy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Strategy Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$",
      "title": "Run Id",
      "type": "string"
    },
    "worked": {
      "title": "Worked",
      "type": "boolean"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "skill_ref",
    "strategy_sha256",
    "run_id",
    "worked",
    "summary"
