      "decisions": [
        {
          "artifact_id": "4692d2b124f118500a669768015b1bf80461f3af3753116040c8bead7afd8a39",
          "media_type": "application/json"
        }
      ],
      "claim": "Material contrast retains the contemporary 0.025/0.1 source.",
      "review": "That source occurs in rejected earlier proposals and stale explanatory prose. The accepted structured plan selects historical v2-T2 at 0.05/0.1, its hypothesis states 0.05/0.1, and both actual material configurations retain 0.05/0.1. Component comparisons therefore use the identified historical T2 0.05 baseline, not a same-weight contemporary 0.025 baseline."
    },
    {
      "decisions": [
        {
          "artifact_id": "e88a3d07ccfae1bbc982eabb3add634c64876b4620254c13384bb5a1faf8e959",
