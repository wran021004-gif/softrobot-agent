{
  "$defs": {
    "EvidenceRef": {
      "description": "Use the stable short reference in the research packet or an evidence response.",
      "pattern": "^(candidate|evaluation|result|evidence)_[1-9][0-9]*$",
      "type": "string"
    },
    "PhysicalMechanismTarget": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "quantity": {
                "enum": [
                  "constraint_output_row_residual",
                  "all_tendon_output_row_residual"
                ]
              }
            },
            "required": [
              "quantity"
            ]
          },
          "then": {
            "properties": {
              "projection_world": {
                "type": "array"
              }
            },
            "required": [
              "projection_world"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "quantity": {
                    "enum": [
                      "directional_acceleration_bounds",
                      "directional_drive",
                      "directional_tendon_row_residual",
                      "motion_decoupling",
                      "directional_material_response"
                    ]
                  }
                },
                "required": [
                  "quantity"
                ]
              },
              {
                "properties": {
                  "reduction": {
                    "enum": [
                      "directional_norm",
                      "directional_component"
                    ]
                  }
                },
                "required": [
                  "reduction"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "direction_world": {
                "type": "array"
              }
            },
            "required": [
              "direction_world"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "reduction": {
                "const": "directional_component"
              }
            },
            "required": [
              "reduction"
            ]
          },
          "then": {
            "properties": {
              "quantity": {
                "enum": [
                  "re_equilibrated_position_response"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reduction": {
                "const": "directional_norm"
              }
            },
            "required": [
              "reduction"
            ]
          },
          "then": {
            "properties": {
              "quantity": {
                "enum": [
                  "tip_jacobian",
                  "tip_acceleration_input_map",
                  "material_point_jacobian"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "direction_generalized": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "direction_world": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "goal": {
          "description": "Main explicitly chooses increase or decrease for differentiation or optimization.",
          "enum": [
            "increase",
            "decrease"
          ],
          "type": "string"
        },
        "material_s": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "projection_world": {
          "anyOf": [
            {
              "items": {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "maxItems": 3,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Orthonormal world output rows for declared row-space coverage; choose a direction or subspace explicitly."
        },
        "quantity": {
          "enum": [
            "tip_jacobian",
            "tendon_jacobian",
            "input_force_map",
            "mass_matrix",
            "tip_acceleration_input_map",
            "drive_singular_values",
            "drive_directions",
            "instantaneous_braking",
            "tendon_row_projection",
            "mass_balance_residual",
            "directional_drive",
            "directional_acceleration_bounds",
            "input_force_directions",
            "directional_tendon_row_residual",
            "motion_decoupling",
            "total_mass",
            "body_inertia_trace",
            "joint_stiffness",
            "joint_damping",
            "material_point_jacobian",
            "all_tendon_output_row_residual"
          ],
          "type": "string"
        },
        "reduction": {
          "anyOf": [
            {
              "enum": [
                "identity",
                "norm",
                "minimum",
                "maximum",
                "directional_norm",
                "generalized_projection",
                "direction_cosine"
              ],
              "type": "string"
            },
            {
              "const": "directional_component",
              "type": "string"
            }
          ],
          "default": "identity"
        },
        "tendon_channel": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "quantity"
      ],
      "type": "object"
    },
    "ScientificControlScope": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "C2 finite search parameterization: full_task adjusts all tendon channels with two independent endpoint knots over the frozen task; time_window adjusts all channels with one triangular pulse per channel and zero endpoint corrections. Choose a scope only when this parameterization answers the question; arbitrary waveform or channel-subset search is not adapted.",
          "enum": [
            "full_task",
            "time_window"
          ],
          "type": "string"
        },
        "window_s": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only control corrections inside this interval; evaluation still covers the complete frozen task."
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "ScientificSourcesV2": {
      "additionalProperties": false,
      "properties": {
        "comparison_candidates": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 2,
          "type": "array"
        },
        "control_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_results": {
          "description": "Saved Conic-compatible model stencil, baseline first. Original optimal sensitivity admission determines its validity.",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 5,
          "type": "array"
        },
        "t1_results": {
          "description": "Comparable saved Native T1 results, baseline first; may select explicit shared-baseline paths/scales. No new search is requested.",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 9,
          "type": "array"
        }
      },
      "type": "object"
    },
    "ScientificStructureV4": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "differentiate",
                  "optimize"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "required": [
                  "goal"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "differentiate",
                  "optimize"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "quantity": {
                    "not": {
                      "enum": [
                        "drive_directions"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "comparison_candidates": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 1,
          "type": "array"
        },
        "control_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScientificControlScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "control_treatment": {
          "enum": [
            "fixed_absolute_tensions",
            "reoptimized"
          ],
          "type": "string"
        },
        "effect_semantics": {
          "enum": [
            "mechanism_effect",
            "fixed_input_response",
            "reoptimized_task_capability"
          ],
          "type": "string"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hypothesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "local_radius_fraction": {
          "default": 0.02,
          "description": "Bounded neighborhood in normalized parameter coordinates, used by the existing SciPy local optimizer.",
          "exclusiveMinimum": 0,
          "maximum": 0.1,
          "type": "number"
        },
        "operating_point": {
          "enum": [
            "frozen_task_initial_state",
            "same_generalized_coordinates",
            "fixed_generalized_pose",
            "saved_native_state"
          ],
          "type": "string"
        },
        "operation": {
          "enum": [
            "inspect",
            "differentiate",
            "optimize",
            "compare"
          ],
          "type": "string"
        },
        "parameter_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actual capability category; segment_lengths is retained as a legacy selector."
        },
        "parameter_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "type": "array"
        },
        "requested_budget": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum original mathematical evaluations for this question. Mechanism cost depends on selected paths, central/one-sided stencils and bounded local search. Fixed-input short responses retain original accounting. For explicit control optimization this caps Native callbacks; saved M2 aggregation never requests new T1 rollouts."
        },
        "response_horizon_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 0.05,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "saved_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "search_strategy": {
          "anyOf": [
            {
              "enum": [
                "response",
                "pattern"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_selection": {
          "$ref": "#/$defs/ScientificSourcesV2"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalMechanismTarget"
            },
            {
              "type": "string"
            }
          ]
        },
        "tensions_n": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "update_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation",
        "effect_semantics",
        "target",
        "operating_point",
        "control_treatment"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Structure research uses structure operations inspect/differentiate/optimize/compare; control research uses control feasibility and effort. Joint structure-control search uses the existing research_plan(search) interface. Main owns all scientific choices.",
  "properties": {
    "domain": {
      "const": "structure",
      "description": "Property domain",
      "type": "string"
    },
    "structure": {
      "$ref": "#/$defs/ScientificStructureV4"
    },
    "version": {
      "const": "scientific_question_v4",
      "default": "scientific_question_v4",
      "description": "Property version",
      "type": "string"
    }
  },
  "required": [
    "domain",
    "structure"
  ],
  "type": "object"
}