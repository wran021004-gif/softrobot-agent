{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "type": "object"
    },
    "PhysicalMechanismTarget": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "type": "string",
          "enum": [
            "tip_jacobian",
            "tendon_jacobian",
            "input_force_map",
            "mass_matrix",
            "tip_acceleration_input_map",
            "drive_singular_values",
            "drive_directions",
            "instantaneous_braking",
            "tendon_row_projection",
            "mass_balance_residual",
            "directional_drive",
            "directional_acceleration_bounds",
            "input_force_directions",
            "directional_tendon_row_residual",
            "motion_decoupling",
            "total_mass",
            "body_inertia_trace",
            "joint_stiffness",
            "joint_damping",
            "material_point_jacobian",
            "all_tendon_output_row_residual"
          ]
        },
        "reduction": {
          "anyOf": [
            {
              "enum": [
                "identity",
                "norm",
                "minimum",
                "maximum",
                "directional_norm",
                "generalized_projection",
                "direction_cosine"
              ],
              "type": "string"
            },
            {
              "const": "directional_component",
              "type": "string"
            }
          ],
          "default": "identity"
        },
        "direction_world": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tendon_channel": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "direction_generalized": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "goal": {
          "enum": [
            "increase",
            "decrease"
          ],
          "type": "string",
          "description": "Main explicitly chooses increase or decrease for differentiation or optimization."
        },
        "material_s": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "projection_world": {
          "anyOf": [
            {
              "items": {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "maxItems": 3,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Orthonormal world output rows for declared row-space coverage; choose a direction or subspace explicitly."
        }
      },
      "required": [
        "quantity"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "quantity": {
                "enum": [
                  "constraint_output_row_residual",
                  "all_tendon_output_row_residual"
                ]
              }
            },
            "required": [
              "quantity"
            ]
          },
          "then": {
            "required": [
              "projection_world"
            ],
            "properties": {
              "projection_world": {
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "quantity": {
                    "enum": [
                      "directional_acceleration_bounds",
                      "directional_drive",
                      "directional_tendon_row_residual",
                      "motion_decoupling",
                      "directional_material_response"
                    ]
                  }
                },
                "required": [
                  "quantity"
                ]
              },
              {
                "properties": {
                  "reduction": {
                    "enum": [
                      "directional_norm",
                      "directional_component"
                    ]
                  }
                },
                "required": [
                  "reduction"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "direction_world"
            ],
            "properties": {
              "direction_world": {
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reduction": {
                "const": "directional_component"
              }
            },
            "required": [
              "reduction"
            ]
          },
          "then": {
            "properties": {
              "quantity": {
                "enum": [
                  "re_equilibrated_position_response"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reduction": {
                "const": "directional_norm"
              }
            },
            "required": [
              "reduction"
            ]
          },
          "then": {
            "properties": {
              "quantity": {
                "enum": [
                  "tip_jacobian",
                  "tip_acceleration_input_map",
                  "material_point_jacobian"
                ]
              }
            }
          }
        }
      ]
    },
    "ScientificControlScope": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "C2 finite search parameterization: full_task adjusts all tendon channels with two independent endpoint knots over the frozen task; time_window adjusts all channels with one triangular pulse per channel and zero endpoint corrections. Choose a scope only when this parameterization answers the question; arbitrary waveform or channel-subset search is not adapted.",
          "enum": [
            "full_task",
            "time_window"
          ],
          "type": "string"
        },
        "window_s": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only control corrections inside this interval; evaluation still covers the complete frozen task."
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "ScientificSourcesV2": {
      "additionalProperties": false,
      "properties": {
        "control_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "comparison_candidates": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 2,
          "type": "array"
        },
        "t1_results": {
          "description": "Comparable saved Native T1 results, baseline first; may select explicit shared-baseline paths/scales. No new search is requested.",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 9,
          "type": "array"
        },
        "model_results": {
          "description": "Saved Conic-compatible model stencil, baseline first. Original optimal sensitivity admission determines its validity.",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 5,
          "type": "array"
        }
      },
      "type": "object"
    },
    "ScientificStructureV4": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "inspect",
            "differentiate",
            "optimize",
            "compare"
          ],
          "type": "string"
        },
        "effect_semantics": {
          "type": "string",
          "enum": [
            "mechanism_effect",
            "fixed_input_response",
            "reoptimized_task_capability"
          ]
        },
        "parameter_group": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "geometry",
                "routing",
                "segment",
                "segment_lengths"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actual capability category; segment_lengths is retained as a legacy selector."
        },
        "parameter_paths": {
          "items": {
            "type": "string",
            "enum": [
              "segment_count",
              "tendon_count",
              "spans",
              "segments.0.length_m",
              "segments.0.young_pa",
              "segments.0.sections.0.kind",
              "segments.0.sections.0.parameters.semi_y_m",
              "segments.0.sections.0.parameters.semi_z_m",
              "segments.0.cells",
              "segments.1.length_m",
              "segments.1.young_pa",
              "segments.1.sections.0.kind",
              "segments.1.sections.0.parameters.height_z_m",
              "segments.1.sections.0.parameters.width_y_m",
              "segments.1.sections.1.kind",
              "segments.1.sections.1.parameters.height_z_m",
              "segments.1.sections.1.parameters.width_y_m",
              "segments.1.cells",
              "tendon_parameters.diameter_m",
              "tendon_parameters.force_limit_n",
              "tendon_parameters.length_servo_gain_n_m",
              "tendon_parameters.pretension_n",
              "spans.0.radius_m",
              "spans.0.phase_rad",
              "spans.0.anchor_s",
              "spans.0.guide_s.0",
              "spans.0.guide_angle_offset_rad",
              "spans.0.anchor_angle_offset_rad",
              "spans.0.angular_offsets_rad.0",
              "spans.0.angular_offsets_rad.1",
              "spans.0.angular_offsets_rad.2",
              "spans.0.angular_offsets_rad.3",
              "control_weights.holding_tip_speed_weight",
              "control_weights.terminal_tip_speed_weight"
            ]
          },
          "maxItems": 2,
          "type": "array",
          "description": "Choose registered physical parameter IDs from this enum, or a parameter_group. Evidence JSON navigation pointers are not parameter IDs."
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalMechanismTarget"
            },
            {
              "type": "string"
            }
          ]
        },
        "hypothesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_selection": {
          "$ref": "#/$defs/ScientificSourcesV2"
        },
        "control_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScientificControlScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "search_strategy": {
          "anyOf": [
            {
              "enum": [
                "response",
                "pattern"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operating_point": {
          "type": "string",
          "enum": [
            "frozen_task_initial_state",
            "same_generalized_coordinates",
            "fixed_generalized_pose",
            "saved_native_state"
          ]
        },
        "control_treatment": {
          "type": "string",
          "enum": [
            "fixed_absolute_tensions",
            "reoptimized"
          ]
        },
        "tensions_n": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "saved_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "update_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "comparison_candidates": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 1,
          "type": "array"
        },
        "requested_budget": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum original mathematical evaluations for this question. Mechanism cost depends on selected paths, central/one-sided stencils and bounded local search. Fixed-input short responses retain original accounting. For explicit control optimization this caps Native callbacks; saved M2 aggregation never requests new T1 rollouts."
        },
        "local_radius_fraction": {
          "default": 0.02,
          "description": "Bounded neighborhood in normalized parameter coordinates, used by the existing SciPy local optimizer.",
          "exclusiveMinimum": 0,
          "maximum": 0.1,
          "type": "number"
        },
        "response_horizon_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 0.05,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation",
        "effect_semantics",
        "target"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "differentiate",
                  "optimize"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "required": [
                  "goal"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "differentiate",
                  "optimize"
                ]
              },
              "target": {
                "type": "object"
              }
            },
            "required": [
              "operation",
              "target"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "properties": {
                      "reduction": {
                        "not": {
                          "const": "identity"
                        }
                      }
                    },
                    "required": [
                      "reduction"
                    ]
                  },
                  {
                    "properties": {
                      "quantity": {
                        "enum": [
                          "mass_balance_residual",
                          "total_mass",
                          "body_inertia_trace",
                          "directional_tendon_row_residual",
                          "motion_decoupling",
                          "finite_time_task_violation"
                        ]
                      }
                    },
                    "required": [
                      "quantity"
                    ]
                  },
                  {
                    "properties": {
                      "quantity": {
                        "const": "directional_drive"
                      },
                      "tendon_channel": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "quantity",
                      "tendon_channel"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect_semantics": {
                "const": "mechanism_effect"
              }
            },
            "required": [
              "effect_semantics"
            ]
          },
          "then": {
            "properties": {
              "control_treatment": {
                "const": "fixed_absolute_tensions"
              },
              "target": {
                "type": "object"
              }
            },
            "required": [
              "operating_point"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "effect_semantics": {
                "const": "fixed_input_response"
              }
            },
            "required": [
              "effect_semantics"
            ]
          },
          "then": {
            "properties": {
              "control_treatment": {
                "const": "fixed_absolute_tensions"
              },
              "target": {
                "type": "string",
                "enum": [
                  "terminal_error_m",
                  "holding_max_error_m",
                  "holding_max_speed_m_s",
                  "tip_position",
                  "tip_velocity"
                ]
              }
            },
            "required": [
              "operating_point"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "effect_semantics": {
                "const": "reoptimized_task_capability"
              }
            },
            "required": [
              "effect_semantics"
            ]
          },
          "then": {
            "properties": {
              "control_treatment": {
                "const": "reoptimized"
              },
              "target": {
                "type": "string",
                "enum": [
                  "terminal_error_m",
                  "holding_max_error_m",
                  "holding_max_speed_m_s",
                  "best_found_J",
                  "optimal_task_violation"
                ]
              },
              "operating_point": {
                "const": "frozen_task_initial_state"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "differentiate",
                  "optimize"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "quantity": {
                    "not": {
                      "enum": [
                        "drive_directions"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Choose operation, effect semantics, target, and parameters. Hypothesis and evaluation cap may reuse the completed diagnose decision. Only uniquely implied execution fields are compiled; distinct working points, sources and scientific methods remain Main choices."
    }
  },
  "additionalProperties": false,
  "description": "Structure research uses structure operations inspect/differentiate/optimize/compare; control research uses control feasibility and effort. Joint structure-control search uses the existing research_plan(search) interface. Main owns all scientific choices.",
  "properties": {
    "version": {
      "const": "scientific_question_v4",
      "default": "scientific_question_v4",
      "type": "string"
    },
    "domain": {
      "type": "string",
      "const": "structure"
    },
    "structure": {
      "$ref": "#/$defs/ScientificStructureV4"
    }
  },
  "required": [
    "domain",
    "structure"
  ],
  "type": "object"
}
