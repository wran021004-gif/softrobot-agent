  "physical_improvement": {
    "preparation": {
      "status": "prepared_no_execution",
      "source_execution": "cf997605885642759ee33920e2c9e2ef",
      "source_report": {
        "artifact_id": "f0bd17ddc970fe7ca19432552803082dd7aa83b3a28593ad21b3333040ae0a5e",
