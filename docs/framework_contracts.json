            "units": {
              "const": "SI",
              "default": "SI",
              "title": "Units",
              "type": "string"
            },
            "coordinate_frame": {
              "const": "world_base_x_forward_yz_cross_section",
              "title": "Coordinate Frame",
              "type": "string"
            },
            "gravity_m_s2": {
              "maxItems": 3,
              "minItems": 3,
