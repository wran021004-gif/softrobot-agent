        "WindowAcceptance": {
          "additionalProperties": false,
          "description": "Minimal executable acceptance; defaults preserve Round 2 development only.\n\nbefore_window means every robot capsule, including radius, is strictly before\nthe near wall face at the initial sampled pose. No initializer is implied.",
          "properties": {
            "initial_robot_region": {
              "default": "unrestricted",
              "enum": [
                "before_window",
                "unrestricted"
              ],
              "title": "Initial Robot Region",
              "type": "string"
            },
            "final_aperture_required": {
              "const": true,
              "default": true,
              "title": "Final Aperture Required",
              "type": "boolean"
            },
            "window_contact_policy": {
              "const": "forbid",
              "default": "forbid",
              "title": "Window Contact Policy",
              "type": "string"
            },
            "final_robot_region": {
              "const": "unrestricted",
              "default": "unrestricted",
              "title": "Final Robot Region",
              "type": "string"
            },
            "randomization": {
              "const": "none",
              "default": "none",
              "title": "Randomization",
              "type": "string"
            }
