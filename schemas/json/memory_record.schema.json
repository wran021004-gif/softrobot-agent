{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$",
          "title": "Run Id",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "pointer": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^/",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        }
      },
      "required": [
        "run_id",
        "path"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$",
      "title": "Run Id",
      "type": "string"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "searchable_metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 16,
      "title": "Searchable Metadata",
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "summary",
    "searchable_metadata",
    "evidence_refs"
  ],
  "title": "MemoryRecord",
  "type": "object"
}
