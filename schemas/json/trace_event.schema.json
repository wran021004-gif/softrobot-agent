{
  "$defs": {
    "Actor": {
      "enum": [
        "human",
        "harness",
        "tool",
        "gate",
        "engineer_agent",
        "coding_agent",
        "diagnosis_agent",
        "skill_system"
      ],
      "title": "Actor",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$",
          "title": "Run Id",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "pointer": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^/",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        }
      },
      "required": [
        "run_id",
        "path"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "DecisionRecord": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "decision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "description": "Public rationale, never private chain-of-thought",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "requested_tools": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$",
            "type": "string"
          },
          "title": "Requested Tools",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "selected_skill_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Selected Skill Refs",
          "type": "array"
        },
        "next_action": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Next Action",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "decision",
        "rationale",
        "next_action"
      ],
      "title": "DecisionRecord",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "RUN_STARTED",
        "RUN_FINISHED",
        "STAGE_STARTED",
        "STAGE_FINISHED",
        "SPEC_VALIDATED",
        "CAPABILITY_RESOLVED",
        "TOOL_STARTED",
        "TOOL_FINISHED",
        "TOOL_FAILED",
        "GATE_EVALUATED",
        "CONTROL_SELECTED",
        "CONTROL_APPLIED",
        "DIAGNOSTIC_STARTED",
        "DIAGNOSTIC_FINISHED",
        "DECISION_RECORDED",
        "REPAIR_PROPOSED",
        "REPAIR_APPLIED",
        "ARTIFACT_CREATED",
        "SKILL_RETRIEVED",
        "SKILL_PROPOSED"
      ],
      "title": "EventType",
      "type": "string"
    },
    "GateEvidence": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$",
          "title": "Gate",
          "type": "string"
        },
        "gate_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/GateType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None only for historical untyped traces; never infer scientific authority"
        },
        "input_metric": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Input Metric",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threshold"
        },
        "comparison": {
          "enum": [
            "<=",
            "==",
            "available"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "decision": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ],
          "title": "Decision",
          "type": "string"
        },
        "authority": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "input_metric",
        "value",
        "threshold",
        "comparison",
        "decision",
        "authority"
      ],
      "title": "GateEvidence",
      "type": "object"
    },
    "GateType": {
      "enum": [
        "HARD",
        "SCREENING",
        "CANONICAL"
      ],
      "title": "GateType",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$",
      "title": "Event Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$",
      "title": "Run Id",
      "type": "string"
    },
    "parent_event_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Event Id"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "operation": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$",
      "title": "Operation",
      "type": "string"
    },
    "status": {
      "enum": [
        "started",
        "pass",
        "fail",
        "not_run",
        "recorded"
      ],
      "title": "Status",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Inputs",
      "type": "object"
    },
    "outputs": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Outputs",
      "type": "object"
    },
    "summary": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Summary",
      "type": "object"
    },
    "failure_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 32,
      "title": "Evidence Refs",
      "type": "array"
    },
    "duration_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration S"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "timestamp",
    "actor",
    "event_type",
    "operation",
    "status"
  ],
  "title": "TraceEvent",
  "type": "object"
}
